{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcus",
  "version": "0.9.1",
  "identifier": "com.rclonegui.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcus",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "visible": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420 ws://localhost:1420 ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: blob: http://localhost:1420; font-src 'self' data: http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4M0I0QTdFNzYzRDNGRjMKUldUelB6MTJma283R0t4RDR1YWtndDNyeXJPQlIzbGFjaHB4cXlqMGxHMjltSkhhSFJBSlJjQnoK",
      "endpoints": ["https://github.com/Pimzino/arcus/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A desktop app for rclone",
    "longDescription": "Arcus puts your computer and your rclone remotes (more than 70 cloud storage providers) side by side, and copies, syncs, moves and mounts between them with live progress. It downloads and verifies the official rclone binary itself.",
    "icon": [
      "../branding/icons/32x32.png",
      "../branding/icons/128x128.png",
      "../branding/icons/128x128@2x.png",
      "../branding/icons/icon.icns",
      "../branding/icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "recommends": ["fuse3", "xdg-utils", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "recommends": ["fuse3", "xdg-utils", "libayatana-appindicator-gtk3"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "upgradeCode": "65d113d3-8a26-5f85-891c-1a74420c4412",
        "fragmentPaths": ["./windows/remove-rclone-gui-shortcuts.wxs"],
        "componentRefs": ["RemoveRcloneGuiStartMenuShortcut", "RemoveRcloneGuiDesktopShortcut"]
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
